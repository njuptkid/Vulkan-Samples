 *
 * Tracer compaction shader - OPTIMIZED version.
 * Removes dead tracers using parallel stream compaction approach.
 * 
 * Two-phase approach:
 * Phase 1 (this shader): Each thread checks its tracer and atomically increments write counter
 * Phase 2 (implicit): Parallel scatter using atomic counter
 */

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer TracerPosIn
{
    vec4 tracer_positions_in[];
};

layout(std430, binding = 1) readonly buffer TracerAgeIn
{
    float tracer_ages_in[];
};

layout(std430, binding = 2) writeonly buffer TracerPosOut
{
    vec4 tracer_positions_out[];
};

layout(std430, binding = 3) writeonly buffer TracerAgeOut
{
    float tracer_ages_out[];
};

layout(std430, binding = 4) readonly buffer AliveCountIn
{
    uint alive_count_in;
};

layout(std430, binding = 5) buffer AliveCountOut
{
    uint alive_count_out;
};

layout(std430, binding = 6) buffer WriteCounter
{
    uint write_counter;
};

layout(push_constant) uniform TracerCompactPC
{
    uint max_tracers;
    float num_to_emit;
    uint pad2;
    uint pad3;
} pc;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    uint total = min(alive_count_in + uint(pc.num_to_emit), pc.max_tracers);
    
    if (idx < total) {
        vec4 tracer = tracer_positions_in[idx];
        float age = tracer_ages_in[idx];
        
        bool is_alive = (tracer.w > 0.0 && age > 0.0);
        
        if (is_alive) {
            uint write_idx = atomicAdd(write_counter, 1);
            
            if (write_idx < pc.max_tracers) {
                tracer_positions_out[write_idx] = tracer;
                tracer_ages_out[write_idx] = age;
            }
        }
    }
}
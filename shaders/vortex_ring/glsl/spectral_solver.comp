#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0, std430) buffer OmegaReal
{
    vec4 omega_real[];
} _176;

layout(binding = 1, std430) buffer OmegaImag
{
    vec4 omega_imag[];
} _188;

layout(binding = 2, std430) buffer VelReal
{
    vec4 vel_real[];
} _244;

layout(binding = 3, std430) buffer VelImag
{
    vec4 vel_imag[];
} _255;

layout(push_constant) uniform SpectralPC
{
    vec4 grid_spacing; // xyz = grid_spacing, w = delta_time
    vec4 grid_min;     // xyz = grid_min, w = viscosity
    uint grid_dim;
} pc;

void main()
{
    uvec3 pos = gl_GlobalInvocationID;
    if (pos.x >= pc.grid_dim || pos.y >= pc.grid_dim || pos.z >= pc.grid_dim)
    {
        return;
    }
    
    uint idx = pos.x + pos.y * pc.grid_dim + pos.z * pc.grid_dim * pc.grid_dim;
    float Lx = float(pc.grid_dim) * pc.grid_spacing.x;
    vec3 k;
    if (pos.x < pc.grid_dim / 2u)
    {
        k.x = (6.283185482025146484375 * float(pos.x)) / Lx;
    }
    else
    {
        k.x = (6.283185482025146484375 * float(int(pos.x) - int(pc.grid_dim))) / Lx;
    }
    float Ly = float(pc.grid_dim) * pc.grid_spacing.y;
    if (pos.y < pc.grid_dim / 2u)
    {
        k.y = (6.283185482025146484375 * float(pos.y)) / Ly;
    }
    else
    {
        k.y = (6.283185482025146484375 * float(int(pos.y) - int(pc.grid_dim))) / Ly;
    }
    float Lz = float(pc.grid_dim) * pc.grid_spacing.z;
    if (pos.z < pc.grid_dim / 2u)
    {
        k.z = (6.283185482025146484375 * float(pos.z)) / Lz;
    }
    else
    {
        k.z = (6.283185482025146484375 * float(int(pos.z) - int(pc.grid_dim))) / Lz;
    }
    float k2 = dot(k, k);
    if (k2 > 0.0)
    {
        // 1. Apply Helmholtz Solenoidal Projection (divergence-free vorticity)
        vec3 k_norm = k / sqrt(k2);
        vec3 omega_r_sol = _176.omega_real[idx].xyz - dot(_176.omega_real[idx].xyz, k_norm) * k_norm;
        vec3 omega_i_sol = _188.omega_imag[idx].xyz - dot(_188.omega_imag[idx].xyz, k_norm) * k_norm;

        // 2. Solve velocity using solenoidal, decayed vorticity
        float decay = exp(((-pc.grid_min.w) * k2) * pc.grid_spacing.w);
        float N3 = float(pc.grid_dim * pc.grid_dim * pc.grid_dim);
        vec3 omega_r_decayed = omega_r_sol * decay;
        vec3 omega_i_decayed = omega_i_sol * decay;
        vec3 vel_r = cross(omega_i_decayed, k) / vec3(k2 * N3);
        vec3 vel_i = cross(k, omega_r_decayed) / vec3(k2 * N3);

        // 3. Compute normalized diffusion change (decay - 1)
        float norm_change = (decay - 1.0) / N3;
        vec3 omega_r_norm = omega_r_sol * norm_change;
        vec3 omega_i_norm = omega_i_sol * norm_change;

        _176.omega_real[idx] = vec4(omega_r_norm, 0.0);
        _188.omega_imag[idx] = vec4(omega_i_norm, 0.0);
        _244.vel_real[idx] = vec4(vel_r, 0.0);
        _255.vel_imag[idx] = vec4(vel_i, 0.0);
    }
    else
    {
        _176.omega_real[idx] = vec4(0.0);
        _188.omega_imag[idx] = vec4(0.0);
        _244.vel_real[idx] = vec4(0.0);
        _255.vel_imag[idx] = vec4(0.0);
    }
}


 *
 * Tracer advection shader.
 * Interpolates velocity from grid and updates tracer positions.
 */

layout(local_size_x = 64) in;

layout(push_constant) uniform TracerAdvectPC
{
    uvec3 grid_dims;
    float pad1;
    vec3  grid_min;
    float pad2;
    vec3  grid_spacing;
    float pad3;
    uint  max_tracers;
    float dt;
    float min_life;
    float max_life;
} pc;

layout(std430, binding = 0) readonly buffer VelGrid
{
    vec4 vel_grid[];
};

layout(std430, binding = 1) readonly buffer TracerPosIn
{
    vec4 tracer_positions[];
};

layout(std430, binding = 2) readonly buffer TracerAgeIn
{
    float tracer_ages[];
};

layout(std430, binding = 3) writeonly buffer TracerPosOut
{
    vec4 tracer_positions_out[];
};

layout(std430, binding = 4) writeonly buffer TracerAgeOut
{
    float tracer_ages_out[];
};

layout(std430, binding = 5) readonly buffer AliveCount
{
    uint alive_count;
};

uint compute_linear_idx(uvec3 idx)
{
    return idx.x + idx.y * pc.grid_dims.x + idx.z * pc.grid_dims.x * pc.grid_dims.y;
}

vec3 trilinear_interpolate_velocity(vec3 pos)
{
    vec3 local_pos = (pos - pc.grid_min) / pc.grid_spacing;
    
    local_pos = clamp(local_pos, vec3(0.0), vec3(pc.grid_dims - 1.0));
    
    uvec3 cell_idx = uvec3(floor(local_pos));
    vec3 frac = fract(local_pos);

    uvec3 c000 = cell_idx;
    uvec3 c100 = min(cell_idx + uvec3(1, 0, 0), pc.grid_dims - uvec3(1));
    uvec3 c010 = min(cell_idx + uvec3(0, 1, 0), pc.grid_dims - uvec3(1));
    uvec3 c110 = min(cell_idx + uvec3(1, 1, 0), pc.grid_dims - uvec3(1));
    uvec3 c001 = min(cell_idx + uvec3(0, 0, 1), pc.grid_dims - uvec3(1));
    uvec3 c101 = min(cell_idx + uvec3(1, 0, 1), pc.grid_dims - uvec3(1));
    uvec3 c011 = min(cell_idx + uvec3(0, 1, 1), pc.grid_dims - uvec3(1));
    uvec3 c111 = min(cell_idx + uvec3(1, 1, 1), pc.grid_dims - uvec3(1));

    vec3 v000 = vel_grid[compute_linear_idx(c000)].xyz;
    vec3 v100 = vel_grid[compute_linear_idx(c100)].xyz;
    vec3 v010 = vel_grid[compute_linear_idx(c010)].xyz;
    vec3 v110 = vel_grid[compute_linear_idx(c110)].xyz;
    vec3 v001 = vel_grid[compute_linear_idx(c001)].xyz;
    vec3 v101 = vel_grid[compute_linear_idx(c101)].xyz;
    vec3 v011 = vel_grid[compute_linear_idx(c011)].xyz;
    vec3 v111 = vel_grid[compute_linear_idx(c111)].xyz;

    vec3 v00 = mix(v000, v100, frac.x);
    vec3 v01 = mix(v001, v101, frac.x);
    vec3 v10 = mix(v010, v110, frac.x);
    vec3 v11 = mix(v011, v111, frac.x);

    vec3 v0 = mix(v00, v10, frac.y);
    vec3 v1 = mix(v01, v11, frac.y);

    return mix(v0, v1, frac.z);
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= alive_count)
        return;

    vec4 tracer = tracer_positions[idx];
    vec3 pos = tracer.xyz;
    float life = tracer.w;  // Use position.w as life/age
    float age = tracer_ages[idx];

    // Check if tracer is dead (age <= 0 or life <= 0)
    if (age <= 0.0 || life <= 0.0)
    {
        // Mark as dead: position.w = -1.0
        tracer_positions_out[idx] = vec4(pos, -1.0);
        tracer_ages_out[idx] = 0.0;
        return;
    }

    // Interpolate velocity from grid
    vec3 velocity = trilinear_interpolate_velocity(pos);
    
    // Advect position
    vec3 new_pos = pos + velocity * pc.dt;
    
    // Decrease life/age
    float new_age = age - pc.dt;
    float new_life = life - pc.dt;
    
    // Check if tracer is out of bounds
    vec3 local_pos = (new_pos - pc.grid_min) / pc.grid_spacing;
    if (any(lessThan(local_pos, vec3(0.0))) || any(greaterThan(local_pos, vec3(pc.grid_dims))))
    {
        // Out of bounds: mark as dead
        tracer_positions_out[idx] = vec4(new_pos, -1.0);
        tracer_ages_out[idx] = 0.0;
        return;
    }
    
    // Still alive
    tracer_positions_out[idx] = vec4(new_pos, max(new_life, 0.0));
    tracer_ages_out[idx] = max(new_age, 0.0);
}
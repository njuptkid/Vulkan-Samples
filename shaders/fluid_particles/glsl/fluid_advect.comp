 *
 * Semi-Lagrangian advection with trilinear interpolation.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(push_constant) uniform PushConstants
{
	float grid_w, grid_h, grid_d, dx;
	float rdx, dt, _pad0, _pad1;
}
pc;

layout(std430, binding = 0) readonly buffer VelIn
{
	float vel_in[];
};

layout(std430, binding = 1) writeonly buffer VelOut
{
	float vel_out[];
};

float ID(float x, float y, float z)
{
	return x + y * pc.grid_w + z * pc.grid_w * pc.grid_h;
}

vec3 loadVel(uint idx)
{
	uint b = idx * 3u;
	return vec3(vel_in[b], vel_in[b + 1u], vel_in[b + 2u]);
}

vec3 trilerp(float x0, float y0, float z0)
{
	float x1 = floor(x0);
	float x2 = x1 + 1.0;
	float y1 = floor(y0);
	float y2 = y1 + 1.0;
	float z1 = floor(z0);
	float z2 = z1 + 1.0;

	// Clamp to valid grid range to prevent out-of-bounds access
	x1 = max(x1, 0.0); x2 = min(x2, pc.grid_w - 1.0);
	y1 = max(y1, 0.0); y2 = min(y2, pc.grid_h - 1.0);
	z1 = max(z1, 0.0); z2 = min(z2, pc.grid_d - 1.0);

	vec3 c000 = loadVel(uint(ID(x1, y1, z1)));
	vec3 c100 = loadVel(uint(ID(x2, y1, z1)));
	vec3 c010 = loadVel(uint(ID(x1, y2, z1)));
	vec3 c110 = loadVel(uint(ID(x2, y2, z1)));
	vec3 c001 = loadVel(uint(ID(x1, y1, z2)));
	vec3 c101 = loadVel(uint(ID(x2, y1, z2)));
	vec3 c011 = loadVel(uint(ID(x1, y2, z2)));
	vec3 c111 = loadVel(uint(ID(x2, y2, z2)));

	float tx = fract(x0);
	float ty = fract(y0);
	float tz = fract(z0);

	vec3 c00 = mix(c000, c100, tx);
	vec3 c01 = mix(c001, c101, tx);
	vec3 c10 = mix(c010, c110, tx);
	vec3 c11 = mix(c011, c111, tx);
	vec3 c0  = mix(c00, c10, ty);
	vec3 c1  = mix(c01, c11, ty);
	return mix(c0, c1, tz);
}

void main()
{
	vec3 pos = vec3(gl_GlobalInvocationID);

	if (pos.x == 0 || pos.y == 0 || pos.z == 0 ||
	    pos.x >= pc.grid_w - 1 || pos.y >= pc.grid_h - 1 || pos.z >= pc.grid_d - 1)
	{
		return;
	}

	uint index = uint(ID(pos.x, pos.y, pos.z));
	uint base  = index * 3u;

	vec3 vel = loadVel(index);

	float bx = pos.x - pc.dt * pc.rdx * vel.x;
	float by = pos.y - pc.dt * pc.rdx * vel.y;
	float bz = pos.z - pc.dt * pc.rdx * vel.z;

	bx = clamp(bx, 0.0, pc.grid_w - 1.0);
	by = clamp(by, 0.0, pc.grid_h - 1.0);
	bz = clamp(bz, 0.0, pc.grid_d - 1.0);

	vec3 result = trilerp(bx, by, bz);

	vel_out[base]     = result.x;
	vel_out[base + 1u] = result.y;
	vel_out[base + 2u] = result.z;
}

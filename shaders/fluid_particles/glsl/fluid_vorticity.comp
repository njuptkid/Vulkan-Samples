 *
 * Compute vorticity (curl) of velocity field.
 * omega = curl(v) = nabla x v
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(push_constant) uniform PushConstants
{
	float grid_w, grid_h, grid_d, dx;
	float rdx, _pad0, _pad1, _pad2;
}
pc;

layout(std430, binding = 0) readonly buffer Vel
{
	float vel[];
};

layout(std430, binding = 1) writeonly buffer Vort
{
	float vort[];
};

float ID(float x, float y, float z)
{
	return x + y * pc.grid_w + z * pc.grid_w * pc.grid_h;
}

vec3 loadVel(uint idx)
{
	uint b = idx * 3u;
	return vec3(vel[b], vel[b + 1u], vel[b + 2u]);
}

void storeVort(uint idx, vec3 w)
{
	uint b = idx * 3u;
	vort[b]     = w.x;
	vort[b + 1u] = w.y;
	vort[b + 2u] = w.z;
}

void main()
{
	vec3 pos = vec3(gl_GlobalInvocationID);

	if (pos.x == 0 || pos.y == 0 || pos.z == 0 ||
	    pos.x >= pc.grid_w - 1 || pos.y >= pc.grid_h - 1 || pos.z >= pc.grid_d - 1)
	{
		return;
	}

	uint index = uint(ID(pos.x, pos.y, pos.z));

	vec3 L  = loadVel(uint(ID(pos.x - 1, pos.y, pos.z)));
	vec3 R  = loadVel(uint(ID(pos.x + 1, pos.y, pos.z)));
	vec3 B  = loadVel(uint(ID(pos.x, pos.y - 1, pos.z)));
	vec3 T  = loadVel(uint(ID(pos.x, pos.y + 1, pos.z)));
	vec3 F  = loadVel(uint(ID(pos.x, pos.y, pos.z - 1)));
	vec3 Bk = loadVel(uint(ID(pos.x, pos.y, pos.z + 1)));

	// curl = nabla x v
	// omega.x = d(vz)/dy - d(vy)/dz
	// omega.y = d(vx)/dz - d(vz)/dx
	// omega.z = d(vy)/dx - d(vx)/dy
	vec3 w;
	w.x = 0.5 * pc.rdx * ((Bk.y - F.y) - (T.z - B.z));
	w.y = 0.5 * pc.rdx * ((R.z - L.z) - (Bk.x - F.x));
	w.z = 0.5 * pc.rdx * ((T.x - B.x) - (R.y - L.y));

	storeVort(index, w);
}

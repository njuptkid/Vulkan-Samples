 *
 * Velocity boundary conditions — reflect velocity at walls.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(push_constant) uniform PushConstants
{
	float grid_w, grid_h, grid_d, dx;
	float rdx, _pad0, _pad1, contain_fluid;
}
pc;

layout(std430, binding = 0) readonly buffer VelIn
{
	float vel_in[];
};

layout(std430, binding = 1) writeonly buffer VelOut
{
	float vel_out[];
};

float ID(float x, float y, float z)
{
	return x + y * pc.grid_w + z * pc.grid_w * pc.grid_h;
}

void main()
{
	vec3 pos = vec3(gl_GlobalInvocationID);

	if (pos.x >= pc.grid_w || pos.y >= pc.grid_h || pos.z >= pc.grid_d)
	{
		return;
	}

	uint index = uint(ID(pos.x, pos.y, pos.z));

	vec3 srcPos = pos;
	float scaleX = 1.0;
	float scaleY = 1.0;
	float scaleZ = 1.0;

	if (pos.x == 0)
	{
		srcPos.x += 1;
		scaleX = -1;
	}
	else if (pos.x == pc.grid_w - 1)
	{
		srcPos.x -= 1;
		scaleX = -1;
	}
	if (pos.y == 0)
	{
		srcPos.y += 1;
		scaleY = -1;
	}
	else if (pos.y == pc.grid_h - 1)
	{
		srcPos.y -= 1;
		scaleY = -1;
	}
	if (pos.z == 0)
	{
		srcPos.z += 1;
		scaleZ = -1;
	}
	else if (pos.z == pc.grid_d - 1)
	{
		srcPos.z -= 1;
		scaleZ = -1;
	}

	if (pc.contain_fluid < 0.5)
	{
		scaleX = 1;
		scaleY = 1;
		scaleZ = 1;
	}

	uint srcBase = uint(ID(srcPos.x, srcPos.y, srcPos.z)) * 3u;
	uint dstBase = index * 3u;

	vel_out[dstBase]     = vel_in[srcBase] * scaleX;
	vel_out[dstBase + 1u] = vel_in[srcBase + 1u] * scaleY;
	vel_out[dstBase + 2u] = vel_in[srcBase + 2u] * scaleZ;
}

 *
 * Scalar boundary conditions — copy from adjacent interior cell.
 * Used for both divergence and pressure.
 */

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(push_constant) uniform PushConstants
{
	float grid_w, grid_h, grid_d, dx;
	float rdx, _pad0, _pad1, _pad2;
}
pc;

layout(std430, binding = 0) readonly buffer ScalarIn
{
	float x_in[];
};

layout(std430, binding = 1) writeonly buffer ScalarOut
{
	float x_out[];
};

float ID(float x, float y, float z)
{
	return x + y * pc.grid_w + z * pc.grid_w * pc.grid_h;
}

void main()
{
	vec3 pos = vec3(gl_GlobalInvocationID);

	if (pos.x >= pc.grid_w || pos.y >= pc.grid_h || pos.z >= pc.grid_d)
	{
		return;
	}

	uint index = uint(ID(pos.x, pos.y, pos.z));

	if (pos.x == 0)
	{
		pos.x += 1;
	}
	else if (pos.x == pc.grid_w - 1)
	{
		pos.x -= 1;
	}
	if (pos.y == 0)
	{
		pos.y += 1;
	}
	else if (pos.y == pc.grid_h - 1)
	{
		pos.y -= 1;
	}
	if (pos.z == 0)
	{
		pos.z += 1;
	}
	else if (pos.z == pc.grid_d - 1)
	{
		pos.z -= 1;
	}

	x_out[index] = x_in[uint(ID(pos.x, pos.y, pos.z))];
}

 *
 * Generates the small angular SDF LUT entirely on the GPU. The PCG gradient
 * hash and Perlin interpolation match particle.vert.
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform UBO
{
	vec4 viewport;
	vec4 blur;
	vec4 shape;
	vec4 noise;
} ubo;

layout(set = 0, binding = 1, std430) buffer RingLUT
{
	vec2 values[];
} ringLut;

const float TWO_PI = 6.28318530718;
const uint LUT_SIZE = 256u;

vec3 hash33(vec3 p)
{
	uvec3 q = uvec3(ivec3(p));
	q = q * 1664525u + 1013904223u;
	q.x += q.y * q.z; q.y += q.z * q.x; q.z += q.x * q.y;
	q ^= q >> 16u;
	q.x += q.y * q.z; q.y += q.z * q.x; q.z += q.x * q.y;
	q ^= q >> 16u;
	return -1.0 + 2.0 * (vec3(q) * (1.0 / 4294967296.0));
}

float perlinNoise3D(vec3 p)
{
	vec3 i = floor(p);
	vec3 f = fract(p);
	vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

	float n000 = dot(hash33(i + vec3(0, 0, 0)), f - vec3(0, 0, 0));
	float n100 = dot(hash33(i + vec3(1, 0, 0)), f - vec3(1, 0, 0));
	float n010 = dot(hash33(i + vec3(0, 1, 0)), f - vec3(0, 1, 0));
	float n110 = dot(hash33(i + vec3(1, 1, 0)), f - vec3(1, 1, 0));
	float n001 = dot(hash33(i + vec3(0, 0, 1)), f - vec3(0, 0, 1));
	float n101 = dot(hash33(i + vec3(1, 0, 1)), f - vec3(1, 0, 1));
	float n011 = dot(hash33(i + vec3(0, 1, 1)), f - vec3(0, 1, 1));
	float n111 = dot(hash33(i + vec3(1, 1, 1)), f - vec3(1, 1, 1));

	float nx00 = mix(n000, n100, u.x);
	float nx10 = mix(n010, n110, u.x);
	float nx01 = mix(n001, n101, u.x);
	float nx11 = mix(n011, n111, u.x);
	return mix(mix(nx00, nx10, u.y), mix(nx01, nx11, u.y), u.z);
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= LUT_SIZE)
	{
		return;
	}

	float angle = (float(i) + 0.5) / float(LUT_SIZE) * TWO_PI;
	float spinAngle = angle + ubo.noise.y;
	vec3 dir = vec3(cos(spinAngle), sin(spinAngle), 0.0);
	vec3 flow = ubo.noise.y * vec3(1.0, 0.0, 0.3) * ubo.noise.x;
	vec3 coord = dir * ubo.shape.w + flow;

	float radius = ubo.shape.x + perlinNoise3D(coord) * ubo.shape.z;
	float halfWidth = ubo.shape.y *
	    (perlinNoise3D(coord + vec3(11223.0)) * ubo.noise.z * 5.0 * ubo.noise.w + 1.0);
	halfWidth = max(halfWidth, ubo.shape.y * 0.05);
	ringLut.values[i] = vec2(radius, halfWidth);
}
